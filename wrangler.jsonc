{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fitness-crm",
	"account_id": "79549c7c02a54b734601f990b46c14b4",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fitness-crm-db",
			"database_id": "7194fec3-c400-421c-a9d7-edfa89e3f912"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "ca43ee0f72ba4bfd84fddfa3491e4851"
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "fitness-crm-storage"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"CLOUDFLARE_ACCOUNT_ID": "79549c7c02a54b734601f990b46c14b4"
	}
}