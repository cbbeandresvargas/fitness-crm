{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fitness-crm",
	"account_id": "7779d2868c06758814b3bad6cae29f6b",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fitness-crm-db",
			"database_id": "ca9fae22-d16d-490b-bb27-fcd854fdd328"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "edaba0a5742445858299c07817446e1c"
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "fitness-crm-storage"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"CLOUDFLARE_ACCOUNT_ID": "7779d2868c06758814b3bad6cae29f6b"
	}
}