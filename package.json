{
  "name": "fitness-crm",
  "version": "1.0.0",
  "type": "module",
  "description": "Fitness CRM built with Hono, Cloudflare Workers, D1, KV, R2 and Tailwind CSS",
  "main": "src/index.ts",
  "scripts": {
    "config:sync": "node scripts/sync-wrangler-env.mjs",
    "postinstall": "npm run config:sync",
    "predev": "npm run config:sync",
    "dev": "wrangler dev --local",
    "dev:client": "vite",
    "predev:remote": "npm run config:sync",
    "dev:remote": "wrangler dev --remote",
    "build:client": "vite build",
    "prebuild": "npm run config:sync",
    "build": "vite build && tsc --noEmit",
    "predeploy": "npm run config:sync",
    "deploy": "npm run build && wrangler deploy",
    "d1:init": "wrangler d1 execute fitness-crm-db --local --file=src/db/schema.sql && wrangler d1 execute fitness-crm-db --local --file=src/db/seed.sql"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "hono": "^4.7.2",
    "lucide-solid": "^1.47.0",
    "papaparse": "^5.5.2",
    "solid-js": "^1.9.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.3.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.140.0"
  }
}
