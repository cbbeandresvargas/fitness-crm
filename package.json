{
  "name": "fitness-crm",
  "version": "1.0.0",
  "type": "module",
  "description": "Fitness CRM built with Hono, Cloudflare Workers, D1, KV, R2 and Tailwind CSS",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "vite build",
    "build": "vite build && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "d1:init": "wrangler d1 execute fitness-crm-db --local --file=src/db/schema.sql && wrangler d1 execute fitness-crm-db --local --file=src/db/seed.sql"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "hono": "^4.7.2",
    "lucide-solid": "^1.47.0",
    "papaparse": "^5.5.2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.3.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.120.1"
  }
}
