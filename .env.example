# ==============================================================================
# Meta WhatsApp Cloud API (v25.0) - Configuración Segura por Variables de Entorno
# ==============================================================================
# Versión de la Graph API de Meta
META_GRAPH_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Identificador del número de teléfono en Meta for Developers (WhatsApp > API Setup)
META_WA_PHONE_NUMBER_ID=

# Token de Acceso Permanente del Usuario del Sistema de Meta (con permisos whatsapp_business_messaging)
META_WA_ACCESS_TOKEN=

# WhatsApp Business Account ID (WABA ID)
META_WA_WABA_ID=

# Token secreto de verificación para el webhook (configúralo igual en el portal de desarrolladores de Meta)
META_WA_VERIFY_TOKEN=fitnessclub_secure_verify_token_2026

# Secreto de la aplicación Meta (App Secret) para validación de firma criptográfica HMAC en webhooks
META_APP_SECRET=
