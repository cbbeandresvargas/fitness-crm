# Configuración de Cloudflare
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui
D1_DATABASE_ID=tu_d1_database_id_aqui
D1_DATABASE_NAME=fitness-crm-db
KV_NAMESPACE_ID=tu_kv_namespace_id_aqui
R2_BUCKET_NAME=fitness-crm-storage

# Opcionales / Seguridad Cloudflare
CLOUDFLARE_API_TOKEN=tu_cloudflare_api_token_aqui
ADMIN_SECRET=tu_admin_secret_super_seguro_aqui
ENCRYPTION_KEY=tu_encryption_key_32_bytes_base64_aqui

# ==============================================================================
# Meta WhatsApp Cloud API (v25.0) - Configuración Segura por Variables de Entorno
# ==============================================================================
# Versión de la Graph API de Meta
META_GRAPH_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Identificador del número de teléfono en Meta for Developers (WhatsApp > API Setup)
META_WA_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Token de Acceso Permanente del Usuario del Sistema de Meta (con permisos whatsapp_business_messaging)
META_WA_ACCESS_TOKEN=tu_meta_access_token_aqui

# WhatsApp Business Account ID (WABA ID)
META_WA_WABA_ID=tu_waba_id_aqui

# Token secreto de verificación para el webhook (configúralo igual en el portal de desarrolladores de Meta)
META_WA_VERIFY_TOKEN=tu_verify_token_webhook_aqui

# Secreto de la aplicación Meta (App Secret) para validación de firma criptográfica HMAC en webhooks
META_APP_SECRET=tu_meta_app_secret_aqui
